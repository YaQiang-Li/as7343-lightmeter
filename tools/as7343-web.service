[Unit]
Description=AS7343 light quality web UI
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/as7343-lightmeter
ExecStart=/home/pi/as7343-lightmeter/.venv/bin/python webui.py --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
